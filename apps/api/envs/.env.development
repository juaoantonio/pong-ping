NODE_ENV=development
VERSION=0.1.0
HOST=0.0.0.0
PORT=3001
API_PREFIX=v1
CORS_ORIGIN=["http://localhost:3000","http://localhost:5173","http://*.localhost:5173","http://127.0.0.1:5173","http://localhost.me:5173","http://*.localhost.me:5173"]
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pong_ping_api
DB_LOGGING=false
DB_SYNCHRONIZE=true
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
AUTH_BASE_URL=http://api.localhost.me:3001/v1
GOOGLE_CALLBACK_URL=http://api.localhost.me:3001/v1/auth/google/callback
SOCIAL_AUTH_DEV_BYPASS_ENABLED=true
SOCIAL_AUTH_DEV_USERS=[{"alias":"admin","provider":"google","subject":"dev-google-admin","email":"admin@example.test","displayName":"Admin Dev","avatarUrl":null,"default":true},{"alias":"member","provider":"google","subject":"dev-google-member","email":"member@example.test","displayName":"Member Dev","avatarUrl":null}]
SYSTEM_ADMIN_FRONTEND_URL=http://localhost.me:5173/admin/tenants
TENANT_FRONTEND_URL=http://localhost.me:5173/club
SESSION_SECRET=local-session-secret-with-at-least-32-chars
SESSION_COOKIE_NAME=pong_ping_session
SESSION_TTL_SECONDS=1209600
ROOT_DOMAIN=localhost.me
RESERVED_TENANT_SUBDOMAINS=["auth","api","www"]
