# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Jetbrains
.idea

# Prisma generated client
generated
apps/*/generated

# dependencies
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store

# testing
/coverage
apps/*/coverage

# turbo
.turbo
apps/*/.turbo

# next.js
/.next/
apps/*/.next/
/out/
apps/*/out/

# production
/build
apps/*/build
/dist
apps/*/dist
packages/*/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
apps/*/.env

# local sqlite data
*.db
*.db-journal

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/*/next-env.d.ts
.env*.local
apps/*/.env*.local
