NODE_ENV=development
VERSION=0.1.0
HOST=127.0.0.1
PORT=3001
API_PREFIX=v1
CORS_ORIGIN=["http://localhost:3000"]
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=pong_ping_api
DB_LOGGING=false
DB_SYNCHRONIZE=true
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
SESSION_SECRET=local-session-secret-with-at-least-32-chars
SESSION_COOKIE_NAME=pong_ping_session
SESSION_TTL_SECONDS=1209600
ROOT_DOMAIN=localhost
RESERVED_TENANT_SUBDOMAINS=["api","www"]
