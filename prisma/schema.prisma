generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  superadmin
  admin
  user
}

enum MatchHistoryKind {
  match
  rollback
}

enum AthleteTechnicalLevel {
  beginner
  intermediate
  advanced
  competitive
}

enum AthleteGripStyle {
  classic
  penhold
}

enum AthletePlayingStyle {
  offensive
  defensive
  all_round
}

model Tenant {
  id              String                    @id @default(cuid())
  name            String
  slug            String                    @unique
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @default(now()) @updatedAt
  users           User[]
  accounts        Account[]
  athleteProfiles AthleteProfile[]
  auditLogs       AuditLog[]
  allowedEmails   AllowedEmail[]
  authInvitations AuthInvitation[]
  playerRankings  PlayerRanking[]
  matchHistories  MatchHistory[]
  tables          PingPongTable[]
  tableMembers    PingPongTableMember[]
  tableQueue      PingPongTableParticipant[]
  tableInvitations PingPongTableInvitation[]

  @@index([slug])
}

model User {
  id                      String                     @id @default(cuid())
  tenantId                String
  name                    String?
  email                   String?
  emailVerified           DateTime?
  image                   String?
  googleId                String?
  avatarUrl               String?
  role                    Role                       @default(user)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @default(now()) @updatedAt
  tenant                  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accounts                Account[]
  sessions                Session[]
  auditLogs               AuditLog[]                 @relation("ActorAuditLogs")
  athleteProfile          AthleteProfile?
  allowedEmails           AllowedEmail[]             @relation("AllowedEmailCreator")
  invitations             AuthInvitation[]           @relation("AuthInvitationCreator")
  playerRanking           PlayerRanking?
  matchHistoriesCreated   MatchHistory[]             @relation("MatchHistoryCreator")
  matchHistoriesWon       MatchHistory[]             @relation("MatchHistoryWinner")
  matchHistoriesLost      MatchHistory[]             @relation("MatchHistoryLoser")
  tableMemberships        PingPongTableMember[]
  tableQueueEntries       PingPongTableParticipant[]
  tableInvitationsCreated PingPongTableInvitation[]  @relation("TableInvitationCreator")
  tablesCreated           PingPongTable[]            @relation("TableCreator")

  @@unique([tenantId, email])
  @@unique([tenantId, googleId])
  @@index([tenantId, createdAt])
  @@index([tenantId, role])
}

model AthleteProfile {
  id                 String                 @id @default(cuid())
  tenantId           String
  userId             String                 @unique
  technicalLevel     AthleteTechnicalLevel?
  gripStyle          AthleteGripStyle?
  playingStyle       AthletePlayingStyle?
  bladeName          String?
  forehandRubberName String?
  backhandRubberName String?
  equipmentNotes     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  tenantId          String
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, providerAccountId])
  @@index([tenantId, userId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorUserId  String?
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
}

model AllowedEmail {
  id              String   @id @default(cuid())
  tenantId        String
  email           String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("AllowedEmailCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId, email])
  @@index([createdByUserId])
}

model AuthInvitation {
  id              String    @id @default(cuid())
  tenantId        String
  tokenHash       String    @unique
  expiresAt       DateTime
  oneTimeUse      Boolean   @default(true)
  usedAt          DateTime?
  usedByEmail     String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User? @relation("AuthInvitationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([createdByUserId])
  @@index([expiresAt])
  @@index([usedAt])
}

model PlayerRanking {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String   @unique
  elo           Int      @default(1000)
  wins          Int      @default(0)
  total_matches Int      @default(0)
  winRate       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, elo])
  @@index([tenantId, wins])
  @@index([elo])
  @@index([wins])
}

model RankLevel {
  id         String @id @default(cuid())
  name       String @unique
  minElo     Int    @unique
  iconImgKey String

  @@index([minElo])
}

model MatchHistory {
  id               String           @id @default(cuid())
  tenantId         String
  tableId          String?
  winnerId         String
  loserId          String
  createdById      String
  rollbackOfId     String?          @unique
  kind             MatchHistoryKind @default(match)
  kFactor          Int
  winnerOldElo     Int
  winnerNewElo     Int
  winnerDiffPoints Int
  loserOldElo      Int
  loserNewElo      Int
  loserDiffPoints  Int
  createdAt        DateTime         @default(now())
  finishedAt       DateTime         @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  table      PingPongTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  winner     User           @relation("MatchHistoryWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  loser      User           @relation("MatchHistoryLoser", fields: [loserId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("MatchHistoryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  rollbackOf MatchHistory?  @relation("MatchHistoryRollback", fields: [rollbackOfId], references: [id], onDelete: Restrict)
  rollbacks  MatchHistory[] @relation("MatchHistoryRollback")

  @@index([tenantId, tableId])
  @@index([tenantId, createdAt])
  @@index([tableId])
  @@index([winnerId])
  @@index([loserId])
  @@index([createdById])
  @@index([kind])
  @@index([createdAt])
}

model PingPongTable {
  id             String                     @id @default(cuid())
  tenantId       String
  name           String
  createdById    String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @default(now()) @updatedAt
  deletedAt      DateTime?
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy      User                       @relation("TableCreator", fields: [createdById], references: [id], onDelete: Restrict)
  invitations    PingPongTableInvitation[]
  matchHistories MatchHistory[]
  members        PingPongTableMember[]
  participants   PingPongTableParticipant[]

  @@index([tenantId, deletedAt, createdAt])
  @@index([createdById])
  @@index([createdAt])
}

model PingPongTableMember {
  id       String        @id @default(cuid())
  tenantId String
  tableId  String
  userId   String
  joinedAt DateTime      @default(now())
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  table    PingPongTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tableId, userId])
  @@index([tenantId, tableId])
  @@index([tenantId, userId])
  @@index([tableId])
  @@index([userId])
}

model PingPongTableParticipant {
  id            String        @id @default(cuid())
  tenantId      String
  tableId       String
  userId        String
  queuePosition Int
  joinedAt      DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  table         PingPongTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tableId, userId])
  @@unique([tableId, queuePosition])
  @@index([tenantId, tableId, queuePosition])
  @@index([tenantId, userId])
  @@index([tableId])
  @@index([userId])
}

model PingPongTableInvitation {
  id           String        @id @default(cuid())
  tenantId     String
  tableId      String
  token        String        @unique
  createdById  String
  expiresAt    DateTime
  oneTimeUse   Boolean       @default(false)
  usedAt       DateTime?
  usedByUserId String?
  createdAt    DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  table        PingPongTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("TableInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, tableId])
  @@index([tenantId, createdAt])
  @@index([tableId])
  @@index([createdById])
  @@index([expiresAt])
  @@index([usedAt])
}
