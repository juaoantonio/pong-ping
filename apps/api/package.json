{
  "name": "@pong-ping/api",
  "version": "0.1.0",
  "description": "Pong Ping backend API service.",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dotenv": "dotenv -e envs/.env -e envs/.env.development -e envs/.env.local",
    "dotenv:test": "dotenv -e envs/.env -e envs/.env.test -e envs/.env.local",
    "dotenv:prod": "dotenv -e envs/.env -e envs/.env.production -e envs/.env.local",
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "services:up": "pnpm run -s dotenv -- ./scripts/services-up.sh",
    "services:down": "pnpm run -s dotenv -- docker compose -f ../../docker-compose.yml down",
    "services:logs": "pnpm run -s dotenv -- docker compose -f ../../docker-compose.yml logs -f postgres",
    "services:ps": "pnpm run -s dotenv -- docker compose -f ../../docker-compose.yml ps",
    "system-admin:create": "pnpm run -s dotenv -- pnpm exec ts-node -r tsconfig-paths/register scripts/create-system-admin.ts",
    "migration:generate": "pnpm run -s dotenv -- pnpm exec typeorm-ts-node-commonjs migration:generate -d ./data-source.ts src/common/database/migrations/migration",
    "migration:run": "pnpm run -s dotenv -- pnpm exec typeorm-ts-node-commonjs migration:run -d ./data-source.ts",
    "migration:revert": "pnpm run -s dotenv -- pnpm exec typeorm-ts-node-commonjs migration:revert -d ./data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "@testcontainers/redis": "^11.14.0",
    "chalk": "^5.6.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "joi": "^18.0.1",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^6.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.8",
    "@swc/core": "^1.15.1",
    "@testcontainers/postgresql": "^11.13.0",
    "@types/express": "^5.0.5",
    "@types/node": "^22.15.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.1.4",
    "testcontainers": "^11.13.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-swc": "^1.5.8",
    "vitest": "^4.0.8"
  }
}
